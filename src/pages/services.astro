---
import BaseLayout from '../layouts/BaseLayout.astro';
const services = [
  { id:'airport', n:'01', title:'Airport Transfers', copy:'Manchester Airport journeys designed around your flight and schedule. Add meet & greet, flight monitoring and a direct pickup plan to keep the transfer straightforward.', points:['Manchester Airport focus','Meet & greet available','Flight-aware journey planning'] },
  { id:'executive', n:'02', title:'Executive / Corporate Travel', copy:'A polished travel option for meetings, client movements, airport connections and busy working days. Quiet, professional and organised around your itinerary.', points:['Business travel','Client & guest transfers','Flexible multi-stop itineraries'] },
  { id:'private-hire', n:'03', title:'Private Hire / Local Journeys', copy:'Pre-booked private hire for local travel across Greater Manchester and beyond, whether it is one important trip or a regular need.', points:['Greater Manchester','Longer-distance journeys','Pre-booked private hire'] },
  { id:'events', n:'04', title:'Event Transfers', copy:'Keep the transport side of weddings, nights out and special occasions simple with planned pickups, drop-offs and group movements.', points:['Weddings & celebrations','Nights out','Special occasions'] }
];
---
<BaseLayout title="Chauffeur Services in Manchester"><section class="container-shell py-16 sm:py-20"><p class="eyebrow">Services</p><h1 class="heading-xl mt-4 max-w-4xl">A professional ride for every kind of important journey.</h1><p class="mt-6 max-w-2xl text-lg leading-7 text-white/55">Choose the service you need and send your journey details. We’ll take it from there.</p><div class="mt-12 space-y-5">{services.map((s)=><section id={s.id} class="card scroll-mt-28 p-7 sm:p-9 lg:grid lg:grid-cols-[90px_1fr_1fr] lg:gap-8"><div class="text-3xl font-semibold text-gold/80">{s.n}</div><div><h2 class="text-2xl font-semibold">{s.title}</h2><p class="mt-3 leading-7 text-white/50">{s.copy}</p></div><ul class="mt-7 space-y-3 text-sm text-white/60 lg:mt-0">{s.points.map((p)=><li>✓ {p}</li>)}</ul></section>)}</div></section><section class="bg-white/[0.025] py-16"><div class="container-shell flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"><div><p class="eyebrow">Need something specific?</p><h2 class="mt-2 text-2xl font-semibold">Tell us what the journey looks like.</h2></div><a class="btn-primary" href="/booking">Request a quote</a></div></section></BaseLayout>
