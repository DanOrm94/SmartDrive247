---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/BookingForm.astro';
---
<BaseLayout title="Book a Transfer"><section class="container-shell py-16 sm:py-20"><div class="grid gap-10 lg:grid-cols-[1fr_.9fr] lg:items-start"><div><p class="eyebrow">Booking &amp; contact</p><h1 class="heading-xl mt-4">Tell us where you’re going.</h1><p class="mt-6 max-w-xl text-lg leading-7 text-white/55">Send your journey details and we’ll come back with availability and a tailored quote.</p><div class="mt-8 grid gap-3 sm:grid-cols-2"><a href="tel:[PHONE]" class="card p-5 transition hover:border-gold/30"><p class="text-xs uppercase tracking-[0.18em] text-gold">Call</p><p class="mt-2 text-lg font-semibold">[PHONE]</p></a><a href="https://wa.me/[PHONE]" class="card p-5 transition hover:border-gold/30"><p class="text-xs uppercase tracking-[0.18em] text-gold">WhatsApp</p><p class="mt-2 text-lg font-semibold">Message us</p></a></div><div class="mt-8 overflow-hidden rounded-2xl border border-white/10 bg-panel"><div class="flex min-h-64 items-center justify-center p-8 text-center"><div><p class="text-sm font-semibold">Google Map service area</p><p class="mt-2 max-w-sm text-xs leading-5 text-white/40">Replace this panel with your Google Maps embed / service-area map when the business address or preferred coverage view is confirmed.</p></div></div></div></div><BookingForm /></div></section></BaseLayout>
