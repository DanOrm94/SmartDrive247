---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/BookingForm.astro';
import TrustBar from '../components/TrustBar.astro';
const services = [
  { title: 'Airport Transfers', text: 'Smooth Manchester Airport journeys with meet & greet and flight-aware planning.', href: '/services#airport' },
  { title: 'Executive Travel', text: 'Discreet, polished travel for directors, clients, meetings and business schedules.', href: '/services#executive' },
  { title: 'Private Hire', text: 'Comfortable local journeys across Greater Manchester and longer-distance trips.', href: '/services#private-hire' },
  { title: 'Events & Occasions', text: 'Reliable transport for weddings, nights out, celebrations and special days.', href: '/services#events' }
];
---
<BaseLayout title="Manchester Chauffeur & Airport Transfers">
  <section class="relative overflow-hidden border-b border-white/10 bg-[radial-gradient(circle_at_85%_15%,rgba(199,165,106,.18),transparent_35%)]">
    <div class="container-shell grid gap-10 py-16 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-24">
      <div>
        <p class="eyebrow">Manchester · Greater Manchester · Beyond</p>
        <h1 class="heading-xl mt-5 max-w-3xl">Travel well.<br /><span class="text-gold">Arrive on time.</span></h1>
        <p class="mt-6 max-w-2xl text-base leading-7 text-white/60 sm:text-lg">SmartDrive247 provides dependable chauffeur and private hire travel for airport transfers, business journeys, local trips and important occasions.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a class="btn-primary" href="/booking">Book Your Transfer</a><a class="btn-secondary" href="tel:[PHONE]">Call [PHONE]</a></div>
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/50"><span>✓ Punctual &amp; professional</span><span>✓ 24/7 availability</span><span>✓ Manchester Airport focus</span></div>
      </div>
      <div class="lg:pl-8"><BookingForm compact /></div>
    </div>
  </section>
  <TrustBar />
  <section class="container-shell py-20 sm:py-24">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow">Our services</p><h2 class="heading-lg mt-3">Professional travel, made simple.</h2></div><a href="/services" class="text-sm font-semibold text-gold hover:text-gold-soft">View all services →</a></div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{services.map((service, i) => <a href={service.href} class="card group p-6 transition hover:-translate-y-1 hover:border-gold/30"><div class="flex h-10 w-10 items-center justify-center rounded-xl border border-gold/25 text-sm text-gold">0{i+1}</div><h3 class="mt-6 text-lg font-semibold">{service.title}</h3><p class="mt-3 text-sm leading-6 text-white/50">{service.text}</p><span class="mt-6 block text-sm font-semibold text-gold">Explore service →</span></a>)}</div>
  </section>
  <section class="bg-white/[0.025] py-20"><div class="container-shell grid gap-12 lg:grid-cols-[1fr_.9fr] lg:items-center"><div><p class="eyebrow">Why SmartDrive247</p><h2 class="heading-lg mt-3">The details matter when the journey matters.</h2><p class="mt-5 max-w-2xl text-base leading-7 text-white/55">From the first confirmation to your final drop-off, the goal is simple: clear communication, comfortable travel and a service you can rely on.</p></div><div class="grid gap-4 sm:grid-cols-2"><div class="card p-6"><p class="text-sm font-semibold">Reliable planning</p><p class="mt-2 text-sm leading-6 text-white/45">Built around your pickup time, route and itinerary.</p></div><div class="card p-6"><p class="text-sm font-semibold">A calm experience</p><p class="mt-2 text-sm leading-6 text-white/45">Professional presentation without the fuss.</p></div><div class="card p-6"><p class="text-sm font-semibold">Flexible travel</p><p class="mt-2 text-sm leading-6 text-white/45">From airport runs to business and events.</p></div><div class="card p-6"><p class="text-sm font-semibold">Local knowledge</p><p class="mt-2 text-sm leading-6 text-white/45">Greater Manchester routes and airport know-how.</p></div></div></div></section>
  <section class="container-shell py-20"><div class="rounded-3xl border border-gold/20 bg-gradient-to-br from-gold/10 to-transparent p-8 sm:p-12 lg:flex lg:items-center lg:justify-between"><div><p class="eyebrow">Ready when you are</p><h2 class="mt-3 text-3xl font-semibold">Make your next journey the easy part.</h2></div><div class="mt-7 flex flex-col gap-3 sm:flex-row lg:mt-0"><a href="/booking" class="btn-primary">Request a Quote</a><a href="https://wa.me/[PHONE]" class="btn-secondary">WhatsApp</a></div></div></section>
</BaseLayout>
