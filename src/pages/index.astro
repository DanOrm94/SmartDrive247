---
import BaseLayout from '../layouts/BaseLayout.astro';

const phone = '07762 253 656';
const sms = `sms:${phone.replace(/\s/g, '')}`;
const tel = `tel:${phone.replace(/\s/g, '')}`;
const instagram = 'https://www.instagram.com/smartdrive247/';

const services = [
  ['01', 'Executive Transfers', 'Door-to-door travel for business and personal journeys, delivered with a calm, professional standard.'],
  ['02', 'Private Hire', 'A dependable private driver for meetings, dinners, shopping, family travel and long-distance journeys.'],
  ['03', 'Event Transport', 'Keep the group moving smoothly for conferences, weddings, celebrations, race days and special events.'],
  ['04', 'Airport Transfers', 'Manchester Airport runs planned around your flight, with clear communication from pickup to drop-off.'],
];

const trust = [
  ['01', 'Professional & discreet', 'A polished, respectful service designed around your time and privacy.'],
  ['02', 'Punctual by design', 'Clear pickup details, practical planning and communication before the journey.'],
  ['03', 'Licensed & insured', 'Placeholder trust signal — replace with your exact licensing / operator details.'],
  ['04', 'Smart vehicles', 'Comfortable, well-presented vehicles chosen to match an executive standard.'],
  ['05', '24/7 availability', 'Early flight, late event or business travel — enquiries are welcome around the clock.'],
  ['06', 'Fair, transparent pricing', 'Premium service without the premium theatre. Straightforward quotes and no guesswork.'],
];

const testimonials = [
  ['“Placeholder review — replace with a real Google or Instagram review.”', 'Client Name', 'Private client · Manchester'],
  ['“Placeholder review — ideal for the confident, polished tone you want to establish.”', 'Client Name', 'Business traveller · Greater Manchester'],
  ['“Placeholder review — keep authentic reviews short, specific and outcome-focused.”', 'Client Name', 'Airport transfer · Manchester'],
];

const localBusinessJson = {
  '@context': 'https://schema.org', '@type': 'TaxiService', name: 'Smart Drive 24/7',
  description: 'Manchester-based executive chauffeur and private hire service specialising in airport transfers, events and executive travel.',
  url: 'https://smartdrive247.co.uk', telephone: '+447762253656',
  areaServed: ['Manchester', 'Greater Manchester', 'Manchester Airport'], sameAs: [instagram],
  openingHours: 'Mo-Su 00:00-24:00', priceRange: '££',
};
---
<BaseLayout>
  <Fragment slot="head">
    <link rel="canonical" href="https://smartdrive247.co.uk/" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJson)} />
  </Fragment>

  <header class="site-header">
    <div class="container header-inner">
      <a href="#top" class="brand" aria-label="Smart Drive 24/7 home"><img src="/images/logotopleft.jpg" alt="Smart Drive 24/7" class="brand-logo" /></a>
      <nav aria-label="Primary navigation" class="nav-links"><a href="#services">Services</a><a href="#why-us">Why us</a><a href="#reviews">Reviews</a><a href="#quote">Contact</a></nav>
      <div class="header-actions"><a href={instagram} target="_blank" rel="noreferrer" class="instagram">Instagram</a><a href={sms} class="cta cta-small">Text 07762 253 656</a></div>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero section-dark">
      <div class="hero-art" aria-hidden="true"><div class="hero-glow"></div><div class="hero-video-wrap"><video class="hero-video" autoplay muted loop playsinline preload="metadata"><source src="/images/download.mp4" type="video/mp4" /></video></div></div>
      <div class="container hero-grid">
        <div class="hero-copy"><p class="eyebrow">Manchester · Greater Manchester · 24/7</p><h1>Manchester’s executive transfer service.</h1><p class="hero-lede">Smart car. Smart driver. Smart price.</p><p class="hero-body">Executive-standard travel for airport runs, private hire, events and everyday journeys — discreet, dependable and designed around your schedule.</p><div class="hero-actions"><a href={sms} class="cta">Text {phone} for a speedy quote <span>↗</span></a><a href={tel} class="phone-link"><span>Call</span> {phone}</a></div><div class="hero-proof"><span class="proof-line"></span><span>Professional service · Clear pricing · 24/7 availability</span></div></div>
        <div class="hero-card"><div><span class="card-label">FASTEST OPTION</span><strong>Text for a quote</strong><p>Tell us pickup, destination, date and time. We’ll get back to you as quickly as possible.</p></div><a href={sms} class="card-arrow" aria-label="Text Smart Drive 24/7 for a quote">↗</a></div>
      </div>
    </section>

    <section id="services" class="section section-surface"><div class="container"><div class="section-heading split-heading"><div><p class="eyebrow">The service</p><h2>Travel that feels <em>sorted.</em></h2></div><p>From a 4am airport collection to a late finish after an event, Smart Drive 24/7 keeps the experience calm, polished and simple.</p></div><div class="service-grid">{services.map(([number,title,text]) => <article class="service-card"><span class="service-number">{number}</span><div class="service-icon">↗</div><h3>{title}</h3><p>{text}</p><a href="#quote" class="text-link">Get a quote <span>↗</span></a></article>)}</div></div></section>
    <section id="why-us" class="section section-dark"><div class="container"><div class="section-heading"><p class="eyebrow">Why Smart Drive 24/7</p><h2>Premium without the <em>show.</em></h2><p>Executive-standard service with a grounded Manchester approach. The detail matters, but the experience should still feel easy.</p></div><div class="trust-grid">{trust.map(([number,title,text]) => <article class="trust-item"><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section>
    <section id="airport" class="section airport-section"><div class="container airport-grid"><div class="airport-visual"><div class="airport-overlay"><span class="eyebrow">Manchester Airport</span><strong>Arrive relaxed.<br />Leave on time.</strong><span class="visual-note">PLACEHOLDER IMAGE — swap for airport/chauffeur photography</span></div></div><div class="airport-copy"><p class="eyebrow">Airport transfers</p><h2>Manchester Airport, handled <em>properly.</em></h2><p>Airport travel has enough moving parts. We keep the ground journey straightforward with planned pickup details, clear communication and a smart, comfortable vehicle.</p><div class="airport-points"><div><strong>Flight-aware planning</strong><span>Placeholder copy for flight tracking / schedule monitoring workflow.</span></div><div><strong>Meet & greet</strong><span>Placeholder copy for your exact arrival meeting process.</span></div><div><strong>Greater Manchester coverage</strong><span>Manchester Airport to the city, suburbs and surrounding areas.</span></div></div><a href={sms} class="cta">Text for a speedy quote <span>↗</span></a></div></div></section>
    <section id="reviews" class="section reviews-section"><div class="container"><div class="section-heading split-heading"><div><p class="eyebrow">Client words</p><h2>Built on repeat <em>trust.</em></h2></div><p>Testimonials are structured as an easy-to-swap array in the page source. Replace the placeholders with verified Google or Instagram reviews.</p></div><div class="reviews-grid">{testimonials.map(([quote,person,meta]) => <figure class="review-card"><div class="stars" aria-label="Five stars">★★★★★</div><blockquote>{quote}</blockquote><figcaption><strong>{person}</strong><span>{meta}</span></figcaption></figure>)}</div></div></section>
    <section id="quote" class="section quote-section"><div class="container quote-grid"><div class="quote-copy"><p class="eyebrow">Get a quote</p><h2>Tell us where you’re going.</h2><p>For the fastest response, text <a href={sms}>{phone}</a>. Prefer to plan by form? Send the details below and we’ll come back to you.</p><a href={instagram} target="_blank" rel="noreferrer" class="instagram-link">Follow @smartdrive247 on Instagram ↗</a><div class="quote-contact"><span>Available 24/7</span><span>Manchester & Greater Manchester</span><span>Manchester Airport runs</span></div></div><form id="quote-form" class="quote-form" action="/api/quote" method="post"><div class="form-row"><label>Full name<input name="name" autocomplete="name" required placeholder="Your name" /></label><label>Mobile number<input name="phone" type="tel" autocomplete="tel" required placeholder="07xxx xxx xxx" /></label></div><div class="form-row"><label>Pickup<input name="pickup" required placeholder="Pickup location" /></label><label>Drop-off<input name="dropoff" required placeholder="Destination" /></label></div><div class="form-row"><label>Date<input name="date" type="date" required /></label><label>Time<input name="time" type="time" required /></label></div><label>Notes<textarea name="notes" rows="4" placeholder="Flight number, passengers, luggage, event details…"></textarea></label><div class="cf-turnstile" data-sitekey="YOUR_TURNSTILE_SITE_KEY" data-theme="dark" aria-label="Spam protection"></div><input type="text" name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" /><button class="cta form-submit" type="submit">Request a speedy quote <span>↗</span></button><p class="form-status" aria-live="polite"></p><p class="form-note">By submitting this form, you’re asking Smart Drive 24/7 to contact you about your journey. Replace this placeholder privacy wording with your final policy before launch.</p></form></div></section>
  </main>

  <footer class="site-footer"><div class="container footer-grid"><div><a href="#top" class="brand"><img src="/images/logotopleft.jpg" alt="Smart Drive 24/7" class="brand-logo" /></a><p class="footer-tag">Executive travel, without the fuss.</p></div><div><span class="footer-label">Contact</span><a href={sms}>Text {phone}</a><a href={tel}>Call {phone}</a><a href={instagram} target="_blank" rel="noreferrer">Instagram @smartdrive247</a></div><div><span class="footer-label">Service area</span><span>Manchester</span><span>Greater Manchester</span><span>Manchester Airport & surrounding areas</span></div><div><span class="footer-label">Hours</span><span>24 hours · 7 days</span><span>Enquiries welcomed around the clock</span></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Smart Drive 24/7. All rights reserved.</span><span>PLACEHOLDER: Add company / licence details.</span></div></footer>
  <script is:inline>
    const form=document.querySelector('#quote-form');const status=document.querySelector('.form-status');form?.addEventListener('submit',async(event)=>{event.preventDefault();const button=form.querySelector('button');button.disabled=true;status.textContent='Sending your enquiry…';try{const response=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok)throw new Error(data.error||'Unable to send your enquiry.');form.reset();status.textContent='Thanks — your quote request has been sent. We’ll be in touch shortly.';}catch(error){status.textContent=error.message||'Something went wrong. Please text 07762 253 656 for the fastest response.';}finally{button.disabled=false;}});
  </script><script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>
<style>
.site-header{position:fixed;z-index:80;top:0;left:0;right:0;background:rgba(10,12,14,.78);border-bottom:1px solid rgba(255,255,255,.08);backdrop-filter:blur(14px)}.header-inner{height:74px;display:flex;align-items:center;justify-content:space-between;gap:1.25rem}.brand{display:inline-flex;align-items:center;gap:.7rem}.brand-logo{display:block;width:auto;height:45.6px;max-width:216px;object-fit:contain;border-radius:4px}.nav-links{display:flex;gap:1.4rem;color:#bfc4c9;font-size:.83rem}.nav-links a:hover,.footer-grid a:hover,.instagram:hover{color:var(--text)}.header-actions{display:flex;align-items:center;gap:.9rem}.instagram{color:#bfc4c9;font-size:.8rem}.cta{display:inline-flex;align-items:center;justify-content:center;gap:.8rem;padding:1rem 1.25rem;border-radius:999px;background:var(--accent);color:#121313;font-weight:800;transition:transform .2s ease,background .2s ease}.cta:hover{transform:translateY(-2px);background:var(--accent-soft)}.cta-small{padding:.7rem 1rem;font-size:.78rem}
.section{padding:7.5rem 0}.section-dark{background:var(--bg)}.section-surface{background:var(--bg-soft)}.eyebrow{margin:0 0 1.1rem;text-transform:uppercase;letter-spacing:.18em;font-size:.68rem;font-weight:700;color:var(--accent)}.section-heading{max-width:720px;margin-bottom:3rem}.section-heading h2{margin:.1rem 0 1rem;font-size:clamp(2.4rem,5vw,4.4rem);line-height:.98}.section-heading p:not(.eyebrow){color:var(--muted);line-height:1.7}.section-heading em{font-style:normal;color:var(--accent)}.split-heading{max-width:none;display:grid;grid-template-columns:1.1fr .9fr;gap:4rem;align-items:end}.split-heading>p{max-width:460px;margin:0 0 .2rem}
.hero{position:relative;min-height:720px;display:grid;align-items:center;overflow:hidden;padding-top:9rem;padding-bottom:5rem}.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.72fr);gap:4rem;align-items:end}.hero-copy{max-width:680px}.hero h1{margin:0 0 1.2rem;max-width:680px;font-size:clamp(3.4rem,6.7vw,6.4rem);line-height:.88;letter-spacing:-.065em}.hero-lede{margin:0 0 .7rem;font-size:1.15rem;font-weight:700}.hero-body{max-width:650px;margin:0;color:#b7bec5;line-height:1.7}.hero-actions{display:flex;align-items:center;gap:1rem;margin-top:2rem}.phone-link{color:#aeb5bc;font-size:.9rem}.phone-link span{margin-right:.45rem}.hero-proof{display:flex;align-items:center;gap:.8rem;margin-top:2.3rem;color:#7f878e;font-size:.72rem}.proof-line{width:42px;height:1px;background:var(--accent)}.hero-art{position:absolute;inset:74px 0 0;z-index:0}.hero-glow{position:absolute;right:3%;top:12%;width:48%;height:65%;background:radial-gradient(circle,rgba(184,162,119,.18),transparent 68%);filter:blur(30px)}.hero-video-wrap{position:absolute;right:0;top:0;width:52%;height:100%;overflow:hidden;border-radius:0 0 0 8rem;border:1px solid rgba(255,255,255,.12);box-shadow:-30px 0 80px rgba(0,0,0,.32)}.hero-video{width:100%;height:100%;object-fit:cover;display:block;opacity:.7}.hero-card{justify-self:end;width:min(100%,340px);padding:1.35rem;border:1px solid rgba(255,255,255,.1);background:rgba(18,21,24,.72);backdrop-filter:blur(16px);border-radius:1.25rem}.hero-card>div{display:flex;flex-direction:column}.card-label{font-size:.63rem;letter-spacing:.16em;color:var(--accent);font-weight:800;margin-bottom:.7rem}.hero-card strong{font:700 1.2rem 'Manrope',sans-serif}.hero-card p{color:var(--muted);font-size:.8rem;line-height:1.6;margin:.5rem 0 0}.card-arrow{margin-top:1.2rem;width:40px;height:40px;border:1px solid rgba(255,255,255,.14);border-radius:50%;display:grid;place-items:center;color:var(--accent)}
.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.service-card{position:relative;min-height:350px;padding:1.8rem;background:var(--bg-soft);transition:transform .2s ease,background .2s ease}.service-card:hover{transform:translateY(-5px);background:#15191c}.service-number{font-size:.68rem;color:#656b71}.service-icon{position:absolute;right:1.6rem;top:1.55rem;width:40px;height:40px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;color:var(--accent)}.service-card h3{margin:4.5rem 0 .9rem;font-size:1.25rem}.service-card p{color:var(--muted);font-size:.86rem;line-height:1.7}.text-link{position:absolute;bottom:1.7rem;font-size:.8rem;font-weight:700}.text-link span{color:var(--accent);margin-left:.35rem}.trust-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line)}.trust-item{display:grid;grid-template-columns:48px 1fr;gap:1rem;padding:2rem 1.5rem;border-bottom:1px solid var(--line)}.trust-item:nth-child(odd){border-right:1px solid var(--line)}.trust-item>span{color:var(--accent);font-size:.7rem}.trust-item h3{margin:0 0 .4rem;font-size:1rem}.trust-item p{margin:0;color:var(--muted);font-size:.82rem;line-height:1.65}.airport-section{background:#0e1114}.airport-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.airport-visual{min-height:600px;border-radius:2rem;overflow:hidden;position:relative;background:linear-gradient(140deg,#22272c,#0c0e10 60%,#1b1711);border:1px solid var(--line)}.airport-overlay{position:absolute;inset:auto 2rem 2rem;display:flex;flex-direction:column;gap:.6rem}.airport-overlay strong{font:700 clamp(2rem,4vw,3.7rem) 'Manrope',sans-serif;line-height:.95}.visual-note{font-size:.63rem;color:#72787e;margin-top:.8rem}.airport-copy>p:not(.eyebrow){color:var(--muted);line-height:1.75}.airport-points{margin:2rem 0}.airport-points>div{padding:1.15rem 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:1.5rem}.airport-points strong{font-size:.85rem}.airport-points span{max-width:300px;color:var(--muted);font-size:.76rem;line-height:1.5}.reviews-section{background:var(--bg-soft)}.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.review-card{margin:0;padding:1.8rem;border:1px solid var(--line);background:#121518;min-height:280px;display:flex;flex-direction:column}.stars{color:var(--accent);letter-spacing:.2em;font-size:.7rem}.review-card blockquote{margin:2rem 0;line-height:1.7;color:#d3d5d7;font-size:.95rem}.review-card figcaption{margin-top:auto;display:flex;flex-direction:column;gap:.2rem}.review-card figcaption strong{font-size:.78rem}.review-card figcaption span{font-size:.7rem;color:#777e85}.quote-section{background:var(--bg)}.quote-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:6rem;align-items:start}.quote-copy h2{font-size:clamp(2.7rem,5vw,5rem);line-height:.94;margin:.2rem 0 1.4rem}.quote-copy>p:not(.eyebrow){color:var(--muted);line-height:1.75}.quote-copy a{color:var(--accent);font-weight:700}.instagram-link{display:inline-block;margin-top:1.5rem;font-size:.85rem}.quote-contact{display:flex;flex-direction:column;gap:.7rem;margin-top:3rem;color:#8d949a;font-size:.75rem}.quote-form{padding:2rem;border:1px solid var(--line);background:#111417;border-radius:1.5rem}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.quote-form label{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem;font-size:.72rem;color:#aeb3b8}.quote-form input,.quote-form textarea{width:100%;border:1px solid rgba(255,255,255,.1);background:#0b0d0f;color:var(--text);border-radius:.65rem;padding:.9rem 1rem;outline:none}.quote-form input:focus,.quote-form textarea:focus{border-color:var(--accent)}.quote-form textarea{resize:vertical}.form-submit{width:100%;border:0;cursor:pointer}.form-submit:disabled{opacity:.6;cursor:wait}.form-status{min-height:1.3rem;color:var(--accent);font-size:.78rem}.form-note{color:#656c72;font-size:.65rem;line-height:1.5}.honeypot{position:absolute!important;left:-9999px!important}.site-footer{padding:5rem 0 2rem;background:#080a0c;border-top:1px solid var(--line)}.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:3rem}.footer-grid>div{display:flex;flex-direction:column;gap:.6rem}.footer-tag{color:#666d73;font-size:.75rem}.footer-label{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:.6rem;font-weight:800;margin-bottom:.5rem}.footer-grid a,.footer-grid span:not(.footer-label){font-size:.75rem;color:#969da4}.footer-bottom{margin-top:4rem;padding-top:1.4rem;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:2rem;color:#555b61;font-size:.63rem}
@media(max-width:900px){.nav-links{display:none}.hero{min-height:820px}.hero-grid{grid-template-columns:1fr;align-items:end;padding-bottom:3rem}.hero-art{opacity:.48}.hero-video-wrap{right:1rem;left:1rem;width:auto;height:62vh;top:42%;border-radius:2rem}.hero-copy{position:relative;z-index:2;margin-top:6rem}.hero-card{display:none}.service-grid{grid-template-columns:repeat(2,1fr)}.split-heading,.airport-grid,.quote-grid{grid-template-columns:1fr;gap:2rem}.reviews-grid{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}.airport-visual{min-height:460px}}
@media(max-width:600px){.header-inner{height:68px}.brand-logo{height:42px;max-width:200px}.header-actions .instagram{display:none}.cta-small{padding:.65rem .8rem;font-size:.7rem}.hero{min-height:780px;padding-top:7rem}.hero h1{font-size:clamp(2.8rem,13vw,4.4rem)}.hero-video-wrap{height:54vh;border-radius:1.4rem}.hero-copy{margin-top:4rem}.hero-actions{align-items:flex-start;flex-direction:column}.hero-proof{margin-top:2rem}.section{padding:5rem 0}.service-grid{grid-template-columns:1fr}.service-card{min-height:300px}.trust-grid{grid-template-columns:1fr}.trust-item:nth-child(odd){border-right:0}.form-row{grid-template-columns:1fr}.quote-form{padding:1.25rem}.footer-grid{grid-template-columns:1fr}.footer-bottom{flex-direction:column}}
</style>