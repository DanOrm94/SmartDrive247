---
import BaseLayout from '../layouts/BaseLayout.astro';

const phone = '07762 253 656';
const sms = `sms:${phone.replace(/\s/g, '')}`;
const tel = `tel:${phone.replace(/\s/g, '')}`;
const instagram = 'https://www.instagram.com/smartdrive247/';

const services = [
  ['01', 'Executive Transfers', 'Door-to-door travel for business and personal journeys, delivered with a calm, professional standard.'],
  ['02', 'Private Hire', 'A dependable private driver for meetings, dinners, shopping, family travel and long-distance journeys.'],
  ['03', 'Event Transport', 'Keep the group moving smoothly for conferences, weddings, celebrations, race days and special events.'],
  ['04', 'Airport Transfers', 'Manchester Airport runs planned around your flight, with clear communication from pickup to drop-off.'],
];

const trust = [
  ['01', 'Professional & discreet', 'A polished, respectful service designed around your time and privacy.'],
  ['02', 'Punctual by design', 'Clear pickup details, practical planning and communication before the journey.'],
  ['03', 'Licensed & insured', 'Placeholder trust signal — replace with your exact licensing / operator details.'],
  ['04', 'Smart vehicles', 'Comfortable, well-presented vehicles chosen to match an executive standard.'],
  ['05', '24/7 availability', 'Early flight, late event or business travel — enquiries are welcome around the clock.'],
  ['06', 'Fair, transparent pricing', 'Premium service without the premium theatre. Straightforward quotes and no guesswork.'],
];

const testimonials = [
  ['“Placeholder review — replace with a real Google or Instagram review.”', 'Client Name', 'Private client · Manchester'],
  ['“Placeholder review — ideal for the confident, polished tone you want to establish.”', 'Client Name', 'Business traveller · Greater Manchester'],
  ['“Placeholder review — keep authentic reviews short, specific and outcome-focused.”', 'Client Name', 'Airport transfer · Manchester'],
];

const localBusinessJson = {
  '@context': 'https://schema.org', '@type': 'TaxiService', name: 'Smart Drive 24/7',
  description: 'Manchester-based executive chauffeur and private hire service specialising in airport transfers, events and executive travel.',
  url: 'https://smartdrive247.co.uk', telephone: '+447762253656',
  areaServed: ['Manchester', 'Greater Manchester', 'Manchester Airport'], sameAs: [instagram],
  openingHours: 'Mo-Su 00:00-24:00', priceRange: '££',
};
---
<BaseLayout>
  <Fragment slot="head">
    <link rel="canonical" href="https://smartdrive247.co.uk/" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJson)} />
  </Fragment>

  <header class="site-header">
    <div class="container header-inner">
      <a href="#top" class="brand" aria-label="Smart Drive 24/7 home">
        <img src="/images/logotopleft.jpg" alt="Smart Drive 24/7" class="brand-logo" />
      </a>
      <nav aria-label="Primary navigation" class="nav-links">
        <a href="#services">Services</a><a href="#why-us">Why us</a><a href="#reviews">Reviews</a><a href="#quote">Contact</a>
      </nav>
      <div class="header-actions">
        <a href={instagram} target="_blank" rel="noreferrer" class="instagram">Instagram</a>
        <a href={sms} class="cta cta-small">Text 07762 253 656</a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <section id="top" class="hero section-dark">
      <div class="hero-art" aria-hidden="true"><div class="hero-glow"></div><div class="hero-video-wrap"><video class="hero-video" autoplay muted loop playsinline preload="metadata"><source src="/images/download.mp4" type="video/mp4" /></video></div></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Manchester · Greater Manchester · 24/7</p>
          <h1>Manchester’s executive transfer service.</h1>
          <p class="hero-lede">Smart car. Smart driver. Smart price.</p>
          <p class="hero-body">Executive-standard travel for airport runs, private hire, events and everyday journeys — discreet, dependable and designed around your schedule.</p>
          <div class="hero-actions"><a href={sms} class="cta">Text {phone} for a speedy quote <span>↗</span></a><a href={tel} class="phone-link"><span>Call</span> {phone}</a></div>
          <div class="hero-proof"><span class="proof-line"></span><span>Professional service · Clear pricing · 24/7 availability</span></div>
        </div>
        <div class="hero-card"><div><span class="card-label">FASTEST OPTION</span><strong>Text for a quote</strong><p>Tell us pickup, destination, date and time. We’ll get back to you as quickly as possible.</p></div><a href={sms} class="card-arrow" aria-label="Text Smart Drive 24/7 for a quote">↗</a></div>
      </div>
    </section>

    <section id="services" class="section section-surface"><div class="container">
      <div class="section-heading split-heading"><div><p class="eyebrow">The service</p><h2>Travel that feels <em>sorted.</em></h2></div><p>From a 4am airport collection to a late finish after an event, Smart Drive 24/7 keeps the experience calm, polished and simple.</p></div>
      <div class="service-grid">{services.map(([number,title,text]) => <article class="service-card"><span class="service-number">{number}</span><div class="service-icon">↗</div><h3>{title}</h3><p>{text}</p><a href="#quote" class="text-link">Get a quote <span>↗</span></a></article>)}</div>
    </div></section>

    <section id="why-us" class="section section-dark"><div class="container">
      <div class="section-heading"><p class="eyebrow">Why Smart Drive 24/7</p><h2>Premium without the <em>show.</em></h2><p>Executive-standard service with a grounded Manchester approach. The detail matters, but the experience should still feel easy.</p></div>
      <div class="trust-grid">{trust.map(([number,title,text]) => <article class="trust-item"><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
    </div></section>

    <section id="airport" class="section airport-section"><div class="container airport-grid">
      <div class="airport-visual"><div class="airport-overlay"><span class="eyebrow">Manchester Airport</span><strong>Arrive relaxed.<br />Leave on time.</strong><span class="visual-note">PLACEHOLDER IMAGE — swap for airport/chauffeur photography</span></div></div>
      <div class="airport-copy"><p class="eyebrow">Airport transfers</p><h2>Manchester Airport, handled <em>properly.</em></h2><p>Airport travel has enough moving parts. We keep the ground journey straightforward with planned pickup details, clear communication and a smart, comfortable vehicle.</p>
        <div class="airport-points"><div><strong>Flight-aware planning</strong><span>Placeholder copy for flight tracking / schedule monitoring workflow.</span></div><div><strong>Meet & greet</strong><span>Placeholder copy for your exact arrival meeting process.</span></div><div><strong>Greater Manchester coverage</strong><span>Manchester Airport to the city, suburbs and surrounding areas.</span></div></div>
        <a href={sms} class="cta">Text for a speedy quote <span>↗</span></a>
      </div>
    </div></section>

    <section id="reviews" class="section reviews-section"><div class="container">
      <div class="section-heading split-heading"><div><p class="eyebrow">Client words</p><h2>Built on repeat <em>trust.</em></h2></div><p>Testimonials are structured as an easy-to-swap array in the page source. Replace the placeholders with verified Google or Instagram reviews.</p></div>
      <div class="reviews-grid">{testimonials.map(([quote,person,meta]) => <figure class="review-card"><div class="stars" aria-label="Five stars">★★★★★</div><blockquote>{quote}</blockquote><figcaption><strong>{person}</strong><span>{meta}</span></figcaption></figure>)}</div>
    </div></section>

    <section id="quote" class="section quote-section"><div class="container quote-grid">
      <div class="quote-copy"><p class="eyebrow">Get a quote</p><h2>Tell us where you’re going.</h2><p>For the fastest response, text <a href={sms}>{phone}</a>. Prefer to plan by form? Send the details below and we’ll come back to you.</p><a href={instagram} target="_blank" rel="noreferrer" class="instagram-link">Follow @smartdrive247 on Instagram ↗</a><div class="quote-contact"><span>Available 24/7</span><span>Manchester & Greater Manchester</span><span>Manchester Airport runs</span></div></div>
      <form id="quote-form" class="quote-form" action="/api/quote" method="post">
        <div class="form-row"><label>Full name<input name="name" autocomplete="name" required placeholder="Your name" /></label><label>Mobile number<input name="phone" type="tel" autocomplete="tel" required placeholder="07xxx xxx xxx" /></label></div>
        <div class="form-row"><label>Pickup<input name="pickup" required placeholder="Pickup location" /></label><label>Drop-off<input name="dropoff" required placeholder="Destination" /></label></div>
        <div class="form-row"><label>Date<input name="date" type="date" required /></label><label>Time<input name="time" type="time" required /></label></div>
        <label>Notes<textarea name="notes" rows="4" placeholder="Flight number, passengers, luggage, event details…"></textarea></label>
        <div class="cf-turnstile" data-sitekey="YOUR_TURNSTILE_SITE_KEY" data-theme="dark" aria-label="Spam protection"></div><input type="text" name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
        <button class="cta form-submit" type="submit">Request a speedy quote <span>↗</span></button><p class="form-status" aria-live="polite"></p><p class="form-note">By submitting this form, you’re asking Smart Drive 24/7 to contact you about your journey. Replace this placeholder privacy wording with your final policy before launch.</p>
      </form>
    </div></section>
  </main>

  <footer class="site-footer"><div class="container footer-grid">
    <div><a href="#top" class="brand"><img src="/images/logotopleft.jpg" alt="Smart Drive 24/7" class="brand-logo" /></a><p class="footer-tag">Executive travel, without the fuss.</p></div>
    <div><span class="footer-label">Contact</span><a href={sms}>Text {phone}</a><a href={tel}>Call {phone}</a><a href={instagram} target="_blank" rel="noreferrer">Instagram @smartdrive247</a></div>
    <div><span class="footer-label">Service area</span><span>Manchester</span><span>Greater Manchester</span><span>Manchester Airport & surrounding areas</span></div>
    <div><span class="footer-label">Hours</span><span>24 hours · 7 days</span><span>Enquiries welcomed around the clock</span></div>
  </div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Smart Drive 24/7. All rights reserved.</span><span>PLACEHOLDER: Add company / licence details.</span></div></footer>

  <script is:inline>
    const form = document.querySelector('#quote-form'); const status = document.querySelector('.form-status');
    form?.addEventListener('submit', async (event) => { event.preventDefault(); const button = form.querySelector('button'); button.disabled = true; status.textContent = 'Sending your enquiry…';
      try { const response = await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}}); const data=await response.json(); if(!response.ok) throw new Error(data.error||'Unable to send your enquiry.'); form.reset(); status.textContent='Thanks — your quote request has been sent. We’ll be in touch shortly.'; }
      catch(error) { status.textContent=error.message||'Something went wrong. Please text 07762 253 656 for the fastest response.'; } finally { button.disabled=false; }
    });
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>

<style>
.site-header{position:fixed;z-index:80;top:0;left:0;right:0;background:rgba(10,12,14,.78);border-bottom:1px solid rgba(255,255,255,.08);backdrop-filter:blur(14px)}
.header-inner{height:74px;display:flex;align-items:center;justify-content:space-between;gap:1.25rem}.brand{display:inline-flex;align-items:center;gap:.7rem}.brand-logo{display:block;width:auto;height:38px;max-width:180px;object-fit:contain;border-radius:4px}.nav-links{display:flex;gap:1.4rem;color:#bfc4c9;font-size:.83rem}.nav-links a:hover,.footer-grid a:hover,.instagram:hover{color:var(--text)}.header-actions{display:flex;align-items:center;gap:.9rem}.instagram{color:#bfc4c9;font-size:.8rem}.cta{display:inline-flex;align-items:center;justify-content:center;gap:.8rem;padding:1rem 1.25rem;border-radius:999px;background:var(--accent);color:#121313;font-weight:800;transition:transform .2s ease,background .2s ease}.cta:hover{transform:translateY(-2px);background:var(--accent-soft)}.cta-small{padding:.7rem 1rem;font-size:.78rem}
.section{padding:7.5rem 0}.section-dark{background:var(--bg)}.section-surface{background:var(--bg-soft)}.eyebrow{margin:0 0 1.1rem;text-transform:uppercase;letter-spacing:.18em;font-size:.68rem;font-weight:700;color:var(--accent)}.section-heading{max-width:720px;margin-bottom:3rem}.section-heading h2{margin:.1rem 0 1rem;font-size:clamp(2.4rem,5vw,4.4rem);line-height:.98}.section-heading p:not(.eyebrow){color:var(--muted);line-height:1.7}.section-heading em{font-style:normal;color:var(--accent)}
.hero{position:relative;min-height:720px;display:grid;align-items:center;overflow:hidden;padding-top:9rem;padding-bottom:5rem}.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.72fr);gap:4rem;align-items:end}.hero-copy{max-width:680px}.hero h1{margin:0 0 1.2rem;max-width:680px;font-size:clamp(4rem,7.6vw,7.3rem);line-height:.88;letter-spacing:-.065em}.hero-lede{margin:0 0 .7rem;font-size:1.15rem;font-weight:700}.hero-body{max-width:650px;margin:0;color:#b7bec5;line-height:1.7}.hero-actions{display:flex;align-items:center;gap:1rem;margin-top:2rem}.phone-link{color:#aeb5bc;font-size:.9rem}.phone-link span{margin-right:.45rem}.hero-proof{display:flex;align-items:center;gap:.8rem;margin-top:2.3rem;color:#7f878e;font-size:.72rem}.proof-line{width:42px;height:1px;background:var(--accent)}.hero-art{position:absolute;inset:74px 0 0;z-index:0}.hero-glow{position:absolute;right:3%;top:12%;width:48%;height:65%;background:radial-gradient(circle,rgba(184,162,119,.18),transparent 68%);filter:blur(30px)}.hero-video-wrap{position:absolute;right:0;top:0;width:52%;height:100%;overflow:hidden;border-radius:0 0 0 8rem;border:1px solid rgba(255,255,255,.08);background:#121518}.hero-video{width:100%;height:100%;object-fit:cover;object-position:center;display:block;filter:saturate(.8) contrast(1.03)}.hero-video-wrap:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,13,15,.86) 0%,rgba(11,13,15,.26) 40%,rgba(11,13,15,.08) 100%)}.hero-card{position:relative;justify-self:end;width:min(100%,360px);padding:1.35rem 1.3rem;border:1px solid rgba(255,255,255,.11);border-radius:1rem;background:rgba(19,23,27,.9);backdrop-filter:blur(14px);box-shadow:0 25px 70px rgba(0,0,0,.3)}.card-label{font-size:.62rem;letter-spacing:.16em;color:var(--accent);font-weight:800;margin-bottom:.5rem;display:block}.hero-card strong{font-size:1.15rem}.hero-card p{margin:.5rem 0 0;color:#9199a1;font-size:.8rem;line-height:1.6}.card-arrow{position:absolute;right:1.2rem;top:1.2rem;width:42px;height:42px;border:1px solid rgba(255,255,255,.12);border-radius:50%;display:grid;place-items:center}
.split-heading{display:grid;grid-template-columns:1fr .8fr;gap:4rem;align-items:end;max-width:none}.split-heading>p{max-width:480px;justify-self:end;margin:0}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.service-card{position:relative;min-height:330px;padding:2rem;border-right:1px solid var(--line);transition:.2s}.service-card:last-child{border-right:0}.service-card:hover{background:rgba(255,255,255,.025);transform:translateY(-4px)}.service-number{color:#626970;font-size:.72rem}.service-icon{position:absolute;right:1.8rem;top:1.8rem;color:var(--accent)}.service-card h3{margin:4.5rem 0 .8rem;font-size:1.25rem}.service-card p{color:var(--muted);font-size:.88rem;line-height:1.65}.text-link{display:inline-flex;gap:.5rem;margin-top:1rem;color:#e5e0d5;font-size:.8rem;font-weight:700}
.trust-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line)}.trust-item{display:grid;grid-template-columns:50px 1fr;gap:1.2rem;padding:1.7rem 0;border-bottom:1px solid var(--line)}.trust-item:nth-child(odd){padding-right:3rem;border-right:1px solid var(--line)}.trust-item:nth-child(even){padding-left:3rem}.trust-item>span{color:var(--accent);font-size:.7rem}.trust-item h3{margin:0 0 .4rem;font-size:1rem}.trust-item p{margin:0;color:var(--muted);font-size:.83rem;line-height:1.6}
.airport-section{background:#111519}.airport-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.airport-visual{min-height:540px;border-radius:2rem;overflow:hidden;background:linear-gradient(145deg,#252b30,#101315);position:relative}.airport-overlay{position:absolute;inset:0;padding:2rem;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(180deg,transparent 30%,rgba(7,9,10,.9))}.airport-overlay strong{font:700 clamp(2.4rem,4vw,4rem)/.95 'Manrope',sans-serif;letter-spacing:-.05em}.visual-note{margin-top:1rem;color:#777f86;font-size:.65rem;text-transform:uppercase;letter-spacing:.08em}.airport-copy>p:not(.eyebrow){color:var(--muted);line-height:1.7}.airport-points{margin:2rem 0}.airport-points>div{display:grid;grid-template-columns:180px 1fr;gap:1rem;padding:1rem 0;border-top:1px solid var(--line)}.airport-points strong{font-size:.82rem}.airport-points span{color:#929aa1;font-size:.78rem;line-height:1.5}
.reviews-section{background:var(--bg-soft)}.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.review-card{margin:0;padding:1.8rem;background:#15191d;border:1px solid var(--line);border-radius:1rem;min-height:260px;display:flex;flex-direction:column}.stars{color:var(--accent);letter-spacing:.2em;font-size:.72rem}.review-card blockquote{margin:2rem 0;font-size:1rem;line-height:1.65;color:#e1e3e4}.review-card figcaption{margin-top:auto;display:flex;flex-direction:column;gap:.25rem}.review-card figcaption strong{font-size:.82rem}.review-card figcaption span{color:#747c83;font-size:.7rem}
.quote-section{background:#0d1012}.quote-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:6rem;align-items:start}.quote-copy h2{font-size:clamp(2.8rem,5vw,5rem);line-height:.95;margin:.1rem 0 1.2rem}.quote-copy>p:not(.eyebrow){color:var(--muted);line-height:1.7}.quote-copy a:not(.instagram-link){color:var(--accent);font-weight:700}.instagram-link{display:inline-block;margin-top:1rem;color:#ded9cf;font-size:.8rem}.quote-contact{display:flex;flex-direction:column;gap:.65rem;margin-top:2.5rem;color:#7f878e;font-size:.75rem}.quote-form{padding:1.6rem;background:#14181b;border:1px solid var(--line);border-radius:1.25rem}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.quote-form label{display:flex;flex-direction:column;gap:.45rem;margin-bottom:1rem;color:#b9c0c5;font-size:.72rem}.quote-form input,.quote-form textarea{width:100%;border:1px solid rgba(255,255,255,.1);background:#0f1215;color:var(--text);border-radius:.7rem;padding:.85rem .9rem;outline:none}.quote-form textarea{resize:vertical}.quote-form input:focus,.quote-form textarea:focus{border-color:var(--accent)}.honeypot{position:absolute!important;left:-9999px!important}.form-submit{border:0;cursor:pointer;width:100%;margin-top:.5rem}.form-submit:disabled{opacity:.6}.form-status{min-height:1.3rem;color:var(--accent);font-size:.78rem}.form-note{color:#646c73;font-size:.65rem;line-height:1.5}
.site-footer{padding:4rem 0 1.5rem;background:#090b0c;border-top:1px solid var(--line)}.footer-grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:3rem;padding-bottom:3rem}.footer-grid>div{display:flex;flex-direction:column;gap:.55rem}.footer-tag{color:#777f86;font-size:.8rem;margin:.8rem 0 0}.footer-label{color:var(--accent);text-transform:uppercase;letter-spacing:.15em;font-size:.6rem;font-weight:800;margin-bottom:.4rem}.footer-grid a,.footer-grid span:not(.footer-label){color:#939ba1;font-size:.75rem}.footer-bottom{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--line);padding-top:1.3rem;color:#5e666c;font-size:.65rem}
@media(max-width:900px){.hero-grid,.airport-grid,.quote-grid{grid-template-columns:1fr;gap:2rem}.hero{min-height:auto}.hero-art{inset:74px 0 0}.hero-video-wrap{width:100%;height:60%;border-radius:0 0 0 4rem;opacity:.52}.hero-grid{align-items:start}.hero-copy{padding-top:3rem}.hero-card{justify-self:start}.service-grid{grid-template-columns:1fr 1fr}.service-card:nth-child(2){border-right:0}.service-card:nth-child(n+3){border-top:1px solid var(--line)}.trust-item:nth-child(odd){padding-right:1.5rem}.trust-item:nth-child(even){padding-left:1.5rem}.reviews-grid{grid-template-columns:1fr}.split-heading{grid-template-columns:1fr;gap:1rem}.split-heading>p{justify-self:start}.footer-grid{grid-template-columns:1fr 1fr}.airport-visual{min-height:400px}}
@media(max-width:600px){.header-inner{height:66px}.brand-logo{height:32px;max-width:145px}.nav-links{display:none}.instagram{display:none}.header-actions{margin-left:auto}.cta-small{font-size:.7rem;padding:.65rem .8rem}.hero{padding-top:7rem;padding-bottom:3rem}.hero-video-wrap{height:48%;border-radius:0 0 0 3rem}.hero h1{font-size:clamp(3.2rem,15vw,5rem)}.hero-actions{align-items:stretch;flex-direction:column}.hero-actions .cta{width:100%}.hero-proof{margin-top:1.5rem}.service-grid,.trust-grid,.form-row,.footer-grid{grid-template-columns:1fr}.service-card,.service-card:nth-child(odd),.service-card:nth-child(even){border-right:0;padding-right:1.4rem;padding-left:1.4rem}.service-card+.service-card{border-top:1px solid var(--line)}.trust-item:nth-child(odd),.trust-item:nth-child(even){padding:1.3rem 0;border-right:0}.airport-points>div{grid-template-columns:1fr;gap:.35rem}.quote-grid{gap:2.5rem}.quote-form{padding:1rem}.footer-bottom{flex-direction:column}.site-footer{padding-bottom:6rem}}
</style>