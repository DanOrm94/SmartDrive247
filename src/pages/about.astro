import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About SmartDrive247"><section class="container-shell py-16 sm:py-20"><div class="grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-start"><div><p class="eyebrow">About SmartDrive247</p><h1 class="heading-xl mt-4">Professional by design. Personal in service.</h1><p class="mt-6 text-lg leading-8 text-white/55">SmartDrive247 is a Manchester-based chauffeur and private hire service built around one simple promise: make important journeys feel well organised.</p><p class="mt-5 leading-7 text-white/50">Whether you are heading to a flight, a boardroom, a wedding or a night out, the service is designed to be dependable, discreet and easy to book.</p></div><div class="card p-7"><p class="eyebrow">Service area</p><h2 class="mt-3 text-2xl font-semibold">Greater Manchester &amp; beyond</h2><p class="mt-3 text-sm leading-6 text-white/50">Manchester, Salford, Trafford, Stockport, Cheshire and surrounding areas, with longer-distance journeys available by arrangement.</p><div class="mt-7 border-t border-white/10 pt-6"><p class="text-sm font-semibold">The SmartDrive standard</p><div class="mt-4 grid gap-3 text-sm text-white/55"><p>01 · Clear communication</p><p>02 · Punctual, planned pickups</p><p>03 · Comfortable, professional travel</p><p>04 · 24/7 pre-booked availability</p></div></div></div></div></section><section class="bg-white/[0.025] py-16"><div class="container-shell grid gap-5 md:grid-cols-3"><div class="card p-6"><p class="text-lg font-semibold">Reliability</p><p class="mt-2 text-sm leading-6 text-white/45">Your itinerary is the starting point, not an afterthought.</p></div><div class="card p-6"><p class="text-lg font-semibold">Professionalism</p><p class="mt-2 text-sm leading-6 text-white/45">A composed, respectful experience from booking to drop-off.</p></div><div class="card p-6"><p class="text-lg font-semibold">Local knowledge</p><p class="mt-2 text-sm leading-6 text-white/45">Manchester and airport experience paired with longer-distance flexibility.</p></div></div></section></BaseLayout>
